INTERNAL_API_KEY=
LOG_LEVEL=INFO

SIGN_HOST=127.0.0.1
SIGN_PORT=8765
SIGN_ALLOWED_ORIGINS=http://localhost:5173
SIGN_ALLOW_PRIVATE_NETWORK=false
SIGN_MODEL_BACKEND=signbart
SIGN_MODEL_PATH=./models/SignBart-WLASL-100/model.safetensors
SIGN_MODEL_VERSION=signbart-wlasl100-hf-8f98ae7
SIGN_VOCABULARY_PATH=./config/mvp-en-v1.json
SIGN_VOCABULARY_VERSION=mvp-en-v1
SIGN_SIGNBART_LOADER=
SIGN_SIGNBART_REPO=../SignBart
SIGN_SIGNBART_CONFIG=../SignBart/configs/WLASL-100.yaml
SIGN_DEVICE=cuda:0
SIGN_USE_FP16=false
SIGN_REQUIRED_FRAMES=64
SIGN_INPUT_WIDTH=224
SIGN_INPUT_HEIGHT=224
SIGN_INPUT_LAYOUT=NCTHW
SIGN_MAX_CLIP_BYTES=10000000
SIGN_MAX_CLIP_DURATION_MS=3000
SIGN_MAX_CONCURRENCY=1
SIGN_QUEUE_SIZE=2
SIGN_INFERENCE_TIMEOUT_MS=2000

# Provisional demo thresholds. Recalibrate with held-out clips before final evaluation.
SIGN_CONFIDENT_THRESHOLD=0.80
SIGN_UNKNOWN_THRESHOLD=0.40
SIGN_MIN_TOP1_TOP2_MARGIN=0.20
SIGN_STORE_DEBUG_MEDIA=false
