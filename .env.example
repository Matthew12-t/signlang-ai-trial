# Shared
INTERNAL_API_KEY=
REQUIRE_INTERNAL_API_KEY=true
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=15
MODEL_QUEUE_TIMEOUT_SECONDS=2
MODEL_CACHE_DIR=
ENABLED_SERVICES=stt,tts
PRELOAD_MODELS=true

# Hugging Face Hub: unduhan artefak model, dan autentikasi hosted inference
# bila STT_PROVIDER/TTS_PROVIDER diset ke hf-api
HF_TOKEN=

# Pilih runtime: local menjalankan bobot model di mesin ini, hf-api memanggil
# Hugging Face hosted inference (butuh HF_TOKEN).
STT_PROVIDER=local
TTS_PROVIDER=local
HF_API_PROVIDER=auto
HF_API_STT_MODEL=openai/whisper-large-v3
HF_API_TTS_MODEL=hexgrad/Kokoro-82M

# STT
HF_STT_MODEL=Systran/faster-whisper-large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_BEAM_SIZE=5
STT_ALLOWED_LANGUAGES=en
STT_VAD_FILTER=true
STT_MIN_SILENCE_MS=500
STT_CONDITION_ON_PREVIOUS_TEXT=false
STT_MAX_AUDIO_BYTES=10000000
STT_MAX_CONCURRENCY=1
STT_TIMEOUT_SECONDS=10

# TTS
HF_TTS_MODEL=openbmb/VoxCPM2
TTS_DEVICE=cuda
TTS_OPTIMIZE=true
TTS_LOAD_DENOISER=false
TTS_NORMALIZE=true
TTS_CFG_VALUE=2.0
TTS_INFERENCE_TIMESTEPS=10
TTS_SEED=42
TTS_ALLOWED_LANGUAGES=en,id
TTS_OUTPUT_FORMAT=wav
TTS_MAX_TEXT_CHARS=500
TTS_CHUNK_CHARS=200
TTS_PAUSE_MS=120
TTS_MAX_CONCURRENCY=1
TTS_TIMEOUT_SECONDS=12

# Recall
HF_RECALL_MODEL=Qwen/Qwen3-8B
RECALL_MAX_CONTEXT_CHARS=24000
RECALL_MAX_ANSWER_TOKENS=160
RECALL_TEMPERATURE=0

# Local Sign Service
SIGN_HOST=127.0.0.1
SIGN_PORT=8765
SIGN_ALLOWED_ORIGINS=http://localhost:5173
SIGN_ALLOW_PRIVATE_NETWORK=false
SIGN_MODEL_BACKEND=mock
SIGN_MODEL_PATH=
SIGN_ALLOWED_ORIGINS=http://localhost:5173
SIGN_ALLOW_PRIVATE_NETWORK=false
SIGN_MODEL_BACKEND=mock
SIGN_MODEL_PATH=
SIGN_MODEL_VERSION=signbart-mvp-v1
SIGN_VOCABULARY_PATH=./config/mvp-en-v1.json
SIGN_VOCABULARY_VERSION=mvp-en-v1
SIGN_SIGNBART_LOADER=
SIGN_SIGNBART_REPO=
SIGN_SIGNBART_CONFIG=
SIGN_DEVICE=cuda:0
SIGN_USE_FP16=false
SIGN_REQUIRED_FRAMES=64
SIGN_INPUT_WIDTH=224
SIGN_INPUT_HEIGHT=224
SIGN_INPUT_LAYOUT=NCTHW
SIGN_MAX_CLIP_BYTES=10000000
SIGN_MAX_CLIP_DURATION_MS=3000
SIGN_MAX_CONCURRENCY=1
SIGN_QUEUE_SIZE=2
SIGN_INFERENCE_TIMEOUT_MS=2000
SIGN_CONFIDENT_THRESHOLD=0.80
SIGN_UNKNOWN_THRESHOLD=0.40
SIGN_MIN_TOP1_TOP2_MARGIN=0.20
SIGN_STORE_DEBUG_MEDIA=false
