# Safe browser-local demo configuration. Leave INTERNAL_API_KEY empty so the
# browser can call the edge-local service directly.
INTERNAL_API_KEY=
SIGN_ALLOWED_ORIGINS=http://localhost:5173
SIGN_ALLOW_PRIVATE_NETWORK=false
SIGN_MODEL_BACKEND=mock
SIGN_MODEL_PATH=
SIGN_MODEL_VERSION=signbart-mvp-v1
SIGN_VOCABULARY_VERSION=mvp-en-v1
SIGN_DEVICE=cpu
SIGN_USE_FP16=false
SIGN_CONFIDENT_THRESHOLD=0.80
SIGN_UNKNOWN_THRESHOLD=0.40
SIGN_MIN_TOP1_TOP2_MARGIN=0.20
SIGN_STORE_DEBUG_MEDIA=false

# Used only by the real profile. Set this to the host checkout of upstream
# SignBart before starting --profile real.
SIGNBART_REPO_HOST_PATH=./SignBart
