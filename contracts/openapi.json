{
  "openapi": "3.1.0",
  "info": {
    "title": "Isyara AI Services",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/gloss/normalize": {
      "post": {
        "tags": [
          "gloss"
        ],
        "summary": "Normalize Gloss",
        "operationId": "normalize_gloss_v1_gloss_normalize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GlossNormalizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlossNormalizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmedSignToken": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Label"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Confirmedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "confirmedAt"
        ],
        "title": "ConfirmedSignToken"
      },
      "GlossNormalizeRequest": {
        "properties": {
          "utteranceId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Utteranceid"
          },
          "language": {
            "type": "string",
            "const": "en",
            "title": "Language"
          },
          "tokens": {
            "items": {
              "$ref": "#/components/schemas/ConfirmedSignToken"
            },
            "type": "array",
            "minItems": 1,
            "title": "Tokens"
          }
        },
        "type": "object",
        "required": [
          "utteranceId",
          "language",
          "tokens"
        ],
        "title": "GlossNormalizeRequest"
      },
      "GlossNormalizeResponse": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "utteranceId": {
            "type": "string",
            "title": "Utteranceid"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "method": {
            "type": "string",
            "enum": [
              "template",
              "qwen"
            ],
            "title": "Method"
          },
          "sourceTokenIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sourcetokenids"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Latencyms"
          }
        },
        "type": "object",
        "required": [
          "requestId",
          "utteranceId",
          "text",
          "method",
          "sourceTokenIds",
          "warnings",
          "latencyMs"
        ],
        "title": "GlossNormalizeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
