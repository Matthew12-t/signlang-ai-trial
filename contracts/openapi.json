  "components": {
    "schemas": {
      "ConfirmedSignToken": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Label"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Confirmedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "confirmedAt"
        ],
        "title": "ConfirmedSignToken"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "requestId",
          "details"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "GlossNormalizeRequest": {
        "properties": {
          "utteranceId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Utteranceid"
          },
          "language": {
            "type": "string",
            "const": "en",
            "title": "Language"
          },
          "tokens": {
            "items": {
              "$ref": "#/components/schemas/ConfirmedSignToken"
            },
            "type": "array",
            "minItems": 1,
            "title": "Tokens"
          }
        },
        "type": "object",
        "required": [
          "utteranceId",
          "language",
          "tokens"
        ],
        "title": "GlossNormalizeRequest"
      },
      "GlossNormalizeResponse": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "utteranceId": {
            "type": "string",
            "title": "Utteranceid"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "method": {
            "type": "string",
            "enum": [
              "template",
              "qwen"
            ],
            "title": "Method"
          },
          "sourceTokenIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sourcetokenids"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Latencyms"
          }
        },
        "type": "object",
        "required": [
          "requestId",
          "utteranceId",
          "text",
          "method",
          "sourceTokenIds",
          "warnings",
          "latencyMs"
        ],
        "title": "GlossNormalizeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "InternalApiKey": {
        "type": "apiKey",
        "description": "Required only when INTERNAL_API_KEY is configured.",
        "in": "header",
        "name": "X-Internal-API-Key"
      }
    }
  }
}
